# Generated by Tses 2026-07-09T12:37:38Z
#
# Production environment — used by compose.prod.yaml
# Copy to .env and fill in real values before deploying.

# Django
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (matches compose.prod.yaml postgres service)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change-me

# JWT
SIGNING_KEY=change-me

# Container startup (handled by compose.prod.yaml environment overrides)
# DJANGO_RUN_MIGRATIONS=1
# DJANGO_COLLECTSTATIC=1

# Celery (matches compose.prod.yaml redis service)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# CELERY_WORKER_CONCURRENCY=4

# Cache (backs DRF rate limiting on signup/login/forgot-password/reset-password;
# same Redis instance as Celery, different DB index)
REDIS_URL=redis://redis:6379/1

# CORS (comma-separated origins, e.g. https://app.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://soludeskscb.com

# S3-compatible object storage
ACCESS_KEY_ID=
ACCESS_SECRET_KEY=
BUCKET_NAME=coursebuilder
BUCKET_URL=https://coursebuilder.lon1.digitaloceanspaces.com

# Provider-neutral AI course generation. Models are deployment-selected rather
# than pinned in application code.
COURSE_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=

# Email (Gmail SMTP — leave EMAIL_HOST_USER blank to use the console backend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com
# Socket-level cap per SMTP operation (seconds) — Django's SMTP backend reads
# this automatically. Prevents a hung provider from stalling the request past
# Cloudflare's 120s Proxy Read Timeout (HTTP 524).
EMAIL_TIMEOUT=30

# Email provider switch:
#   "smtp"     (default, Django SMTP backend — Gmail or Cloudflare SMTP)
#   "resend"   (Resend REST API)
#   "cloudflare" (Cloudflare Email Service REST API — HTTPS, no SMTP egress required.
#              Token needs the Email Sending: Edit permission, and DEFAULT_FROM_EMAIL's
#              domain must be onboarded for Email Sending on the owning account.)
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Authentication / Email verification links
FRONTEND_URL="http://localhost:3000", "http://localhost:3001"
EMAIL_TOKEN_BYTES=32
EMAIL_TOKEN_EXPIRY_MINUTES=60
EMAIL_TOKEN_MAX_ATTEMPTS=5
EMAIL_TOKEN_RESEND_COOLDOWN_SECONDS=60

# Super admin bootstrap is enabled by code for local/development/staging-like
# environments and disabled when DJANGO_ENV=production. It is one-time and
# rate-limited; never deploy production with a non-production DJANGO_ENV.
#
# Mandated-role MFA (ADMIN/SUPER_ADMIN) follows the same DJANGO_ENV split:
# non-production environments skip the login MFA challenge entirely, so a
# bootstrapped super admin just logs in with email + password. Only
# DJANGO_ENV=production enforces the MFA challenge at login.

# Field-level encryption (MFA TOTP secrets, recovery codes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Gunicorn (optional overrides for the api service)
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120

PAYSTACK_PUBLIC_KEY=paystack-publi-key
PAYSTACK_SECRET_KEY=paystack-secret-key

# FLUTTERWAVE
FLUTTERWAVE_CLIENT_ID=the-flutterwave_client_id
FLUTTERWAVE_CLIENT_SECRET=the-flutterwave_client_secret
FLUTTERWAVE_ENCRYPTION_KEY=the-flutterwave_encryption_key
FLUTTERWAVE_BASE_URL=https://developersandbox-api.flutterwave.com #Change to live url in prod (https://api.flutterwave.com)
FLUTTERWAVE_SECRET_HASH=the-flutterwave-secret-hash
1FIELD_ENCRYPTION_KEY=used-for-encryption

# SISSL
SISSL_BASE_URL=https://api.sissl.com
SISSL_API_TOKEN=your-sissl-api-token

SISSL_FACE_MATCH_THRESHOLD=80
SISSL_FLAGGING_FLOOR=60
SISSL_LIVENESS_THRESHOLD=80
SISSL_HTTP_TIMEOUT=30
SISSL_CONNECT_TIMEOUT=5
SISSL_MAX_RETRIES=2
KYC_SLA_HOURS=48
SISSL_LIVENESS_HOURLY_CAP=5

# YOUVERIFY
YOUVERIFY_WEBHOOK_SECRET=dummy-secret-key
YOUVERIFY_API_KEY=dummy-api-key
YOUVERIFY_BASE_URL=the-youverify-base-url # https://api.sandbox.youverify.co for sandbox/test environment
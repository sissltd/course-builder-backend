# Generated by Tses 2026-07-09T12:37:38Z
#
# Production environment — used by compose.prod.yaml
# Copy to .env and fill in real values before deploying.

# Django
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (matches compose.prod.yaml postgres service)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change-me

# JWT
SIGNING_KEY=change-me

# Container startup (handled by compose.prod.yaml environment overrides)
# DJANGO_RUN_MIGRATIONS=1
# DJANGO_COLLECTSTATIC=1

# Celery (matches compose.prod.yaml redis service)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# CELERY_WORKER_CONCURRENCY=4

# Cache (backs DRF rate limiting on signup/login/forgot-password/reset-password;
# same Redis instance as Celery, different DB index)
REDIS_URL=redis://redis:6379/1

# CORS (comma-separated origins, e.g. https://app.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://soludeskscb.com

# Email (Gmail SMTP — leave EMAIL_HOST_USER blank to use the console backend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com

# Authentication / Email verification links
FRONTEND_URL="http://localhost:3000", "http://localhost:3001"
EMAIL_TOKEN_BYTES=32
EMAIL_TOKEN_EXPIRY_MINUTES=60
EMAIL_TOKEN_MAX_ATTEMPTS=5
EMAIL_TOKEN_RESEND_COOLDOWN_SECONDS=60

# Super admin bootstrap
# Shared secret required by POST /api/v1/auth/superadmin/bootstrap/, which claims
# the platform's single Super Admin seat. Leave BLANK to disable that endpoint -
# blank does not mean "no token required", it means the endpoint returns 403.
# Set a long random value (e.g. `openssl rand -hex 32`), bootstrap once, then
# clear it again so the secret stops being a live credential.
SUPERADMIN_BOOTSTRAP_TOKEN=

# Field-level encryption (MFA TOTP secrets, recovery codes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Gunicorn (optional overrides for the api service)
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120


PAYSTACK_PUBLIC_KEY=paystack-publi-key
PAYSTACK_SECRET_KEY=paystack-secret-key
1FIELD_ENCRYPTION_KEY=used-for-encryption
